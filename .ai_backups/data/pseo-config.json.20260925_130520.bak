      "heroHeading": "{brand} {intent} et Codes Promo",
      "heroSub": "Vérifiés quotidiennement. Les utilisateurs économisent en moyenne {avgSavings} sur leurs commandes {brand}.",
      "faq1_q": "Comment utiliser mon code promo {brand} ?",
      "faq1_a": "Choisissez une offre, effectuez la vérification en 1 étape pour afficher le code complet, copiez-le et collez-le sur {domain} lors du paiement.",
      "faq2_q": "Ces codes promo {brand} sont-ils fonctionnels ?",
      "faq2_a": "Oui, tous les codes de réduction pour {brand} sont vérifiés régulièrement pour garantir leur validité."
    },
    "pt": {
      "title": "{brand} {intent} e Cupons Verificados - Economize {bestDiscount} | CouponFinder",
      "metaDesc": "Acesse os melhores {brand} {intent} e cupons de desconto ativos hoje. Economize até {bestDiscount} em suas compras online.",
      "heroHeading": "{brand} {intent} e Descontos",
      "heroSub": "Verificados todos os dias. Economia média de {avgSavings} em compras na {brand}.",
      "faq1_q": "Como resgatar e aplicar o cupom de desconto da {brand}?",
