<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - CouponFinder</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/png" href="logo.png">

    <!-- Fonts & CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --accent: #10b981;
            --accent-hover: #059669;
            --accent-light: #d1fae5;
            --bg: #f8fafc;
            --surface: #ffffff;
            --border: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --sidebar-width: 260px;
        }

        [data-theme="dark"] {
            --bg: #0b1120;
            --surface: #1e293b;
            --border: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-light: rgba(16, 185, 129, 0.15);
        }

        body {
            font-family: 'Lexend', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Top Bar */
        .admin-topbar {
            height: 64px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 800;
            font-size: 1.15rem;
            color: var(--text-main);
            text-decoration: none;
        }

        .admin-badge {
            background: var(--accent-light);
            color: var(--accent);
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        /* Layout */
        .admin-wrapper {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        .admin-sidebar {
            width: var(--sidebar-width);
            background: var(--surface);
            border-right: 1px solid var(--border);
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex-shrink: 0;
        }

        .admin-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            transition: all 0.2s ease;
        }

        .admin-nav-item:hover {
            background: var(--accent-light);
            color: var(--accent);
        }

        .admin-nav-item.active {
            background: var(--accent);
            color: white;
        }

        .admin-nav-item.active i {
            color: white;
        }

        .admin-content {
            flex: 1;
            padding: 30px;
            max-width: 1300px;
        }

        /* Cards & Metrics */
        .metric-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .metric-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: var(--accent-light);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .metric-val {
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1.1;
        }

        .metric-lbl {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 4px;
            font-weight: 500;
        }

        .admin-panel-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .admin-card-title {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .admin-card-subtitle {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        /* Buttons & Forms */
        .btn-theme-action {
            background: var(--accent);
            color: white;
            border: none;
            padding: 9px 18px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.86rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-theme-action:hover {
            background: var(--accent-hover);
            color: white;
        }

        .btn-theme-outline {
            background: transparent;
            color: var(--text-main);
            border: 1px solid var(--border);
            padding: 8px 14px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.84rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-theme-outline:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .form-control, .form-select {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-main);
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 0.88rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-light);
            background: var(--surface);
            color: var(--text-main);
        }

        /* Modals & Login Overlay */
        .login-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(8px);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-modal-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            padding: 36px 30px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.3);
            text-align: center;
        }

        .login-logo {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            margin-bottom: 16px;
        }

        .toast-notification {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #10b981;
            color: white;
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.88rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            display: none;
            z-index: 10000;
        }
    </style>
</head>
<body>

    <!-- Toast -->
    <div class="toast-notification" id="toastNotice">
        <i class="bi bi-check-circle-fill me-1"></i> <span id="toastMsg">Action completed successfully.</span>
    </div>

    <!-- Login Authentication Overlay -->
    <div class="login-overlay" id="loginOverlay">
        <div class="login-modal-box">
            <img src="/logo.png" alt="CouponFinder" class="login-logo" onerror="this.style.display='none'">
            <h3 style="font-weight: 800; font-size: 1.4rem;">Admin Verification</h3>
            <p style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 24px;">Enter your credentials configured in environment variables.</p>
            <form id="adminLoginForm" onsubmit="handleLogin(event)">
                <div class="mb-3 text-start">
                    <label class="form-label" style="font-size: 0.8rem; font-weight: 600;">Username</label>
                    <input type="text" id="adminUserInput" class="form-control" placeholder="admin" required autocomplete="username">
                </div>
                <div class="mb-3 text-start">
                    <label class="form-label" style="font-size: 0.8rem; font-weight: 600;">Password</label>
                    <input type="password" id="adminPassInput" class="form-control" placeholder="••••••••••••" required autocomplete="current-password">
                </div>
                <div id="loginErrorMsg" style="color: #ef4444; font-size: 0.8rem; font-weight: 600; margin-bottom: 12px; display: none;"></div>
                <button type="submit" class="btn-theme-action w-100 justify-content-center" id="loginSubmitBtn" style="padding: 11px;">
                    <i class="bi bi-shield-lock-fill"></i> Authenticate & Enter
                </button>
            </form>
        </div>
    </div>

    <!-- Topbar -->
    <header class="admin-topbar">
        <div class="d-flex align-items-center gap-3">
            <a href="/" class="admin-brand">
                <img src="/logo.png" alt="Logo" style="height: 28px; border-radius: 6px;" onerror="this.style.display='none'">
                <span>CouponFinder</span>
            </a>
            <span class="admin-badge"><i class="bi bi-shield-check"></i> SECURE ADMIN</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span style="font-size: 0.82rem; color: var(--text-muted);">
                Logged in as <strong id="currentAdminName" style="color: var(--text-main);">admin</strong>
            </span>
            <button class="btn-theme-outline" onclick="toggleTheme()" title="Toggle Dark/Light">
                <i class="bi bi-moon-stars" id="themeIcon"></i>
            </button>
            <button class="btn-theme-outline" onclick="handleLogout()" style="color: #ef4444;">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </div>
    </header>

    <!-- Wrapper -->
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar">
            <button class="admin-nav-item active" onclick="switchTab('overview', this)">
                <i class="bi bi-speedometer2"></i> Dashboard Overview
            </button>
            <button class="admin-nav-item" onclick="switchTab('pseo', this)">
                <i class="bi bi-layers-fill"></i> pSEO Engine & Generator
            </button>
            <button class="admin-nav-item" onclick="switchTab('translations', this)">
                <i class="bi bi-translate"></i> Languages (EN/ES/FR/PT)
            </button>
            <button class="admin-nav-item" onclick="switchTab('sitemaps', this)">
                <i class="bi bi-diagram-3-fill"></i> Sitemaps & Crawlers
            </button>
            <button class="admin-nav-item" onclick="switchTab('downloader', this)">
                <i class="bi bi-download"></i> Media Downloader
            </button>
            <button class="admin-nav-item" onclick="switchTab('locker', this)">
                <i class="bi bi-lock-fill"></i> CPA Locker & Security
            </button>
        </aside>

        <!-- Main Workspace -->
        <main class="admin-content">

            <!-- TAB 1: OVERVIEW -->
            <section id="tab-overview">
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="metric-card">
                            <div class="metric-icon"><i class="bi bi-file-earmark-code-fill"></i></div>
                            <div>
                                <div class="metric-val" id="metricTotalPages">2,160</div>
                                <div class="metric-lbl">Total pSEO Pages</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card">
                            <div class="metric-icon"><i class="bi bi-tags-fill"></i></div>
                            <div>
                                <div class="metric-val" id="metricTotalBrands">45</div>
                                <div class="metric-lbl">Active Global Brands</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card">
                            <div class="metric-icon"><i class="bi bi-globe2"></i></div>
                            <div>
                                <div class="metric-val" id="metricTotalLanguages">4</div>
                                <div class="metric-lbl">Languages (en/es/fr/pt)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="metric-card">
                            <div class="metric-icon"><i class="bi bi-diagram-3-fill"></i></div>
                            <div>
                                <div class="metric-val" id="metricTotalSitemaps">5</div>
                                <div class="metric-lbl">Sub-Sitemaps Generated</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-panel-card">
                    <div class="admin-card-title">
                        <span>System Health & Quick Links</span>
                        <a href="/sitemap.xml" target="_blank" class="btn-theme-outline"><i class="bi bi-box-arrow-up-right"></i> View sitemap.xml</a>
                    </div>
                    <div class="admin-card-subtitle">Real-time status of routing, security and crawlable indexes</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="fw-bold"><i class="bi bi-check-circle-fill text-success me-1"></i> CPA Content Locker</div>
                                <small class="text-muted">Strict 1-offer mandatory anti-bypass active with OGAds postback routing.</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="fw-bold"><i class="bi bi-check-circle-fill text-success me-1"></i> Crawler Sub-Sitemaps</div>
                                <small class="text-muted">500 URLs per sub-sitemap chunk for fast Googlebot discovery.</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="fw-bold"><i class="bi bi-shield-check text-success me-1"></i> JWT Authentication</div>
                                <small class="text-muted">Stateless HMAC-SHA256 signature verification active.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TAB 2: PSEO ENGINE -->
            <section id="tab-pseo" style="display:none;">
                <div class="admin-panel-card">
                    <div class="admin-card-title">
                        <span>Bulk Page Multiplier Engine</span>
                        <button class="btn-theme-action" onclick="runBulkGenerate()"><i class="bi bi-lightning-charge-fill"></i> Scale to Thousands of Pages</button>
                    </div>
                    <div class="admin-card-subtitle">Automatically multiplies Brands &times; Search Intents &times; Languages into high-converting programmatic pages.</div>

                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold" style="font-size:0.82rem;">Add New Brand</label>
                            <input type="text" id="newBrandName" class="form-control" placeholder="Brand Name (e.g. Netflix)">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold" style="font-size:0.82rem;">Brand Slug</label>
                            <input type="text" id="newBrandSlug" class="form-control" placeholder="slug (e.g. netflix)">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold" style="font-size:0.82rem;">Best Discount</label>
                            <input type="text" id="newBrandDiscount" class="form-control" placeholder="e.g. 50% OFF">
                        </div>
                        <div class="col-md-2">
                            <button class="btn-theme-action w-100" onclick="addNewBrand()"><i class="bi bi-plus-lg"></i> Add Brand</button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size: 0.85rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>Brand</th>
                                    <th>Slug</th>
                                    <th>Category</th>
                                    <th>Top Discount</th>
                                    <th>Avg Savings</th>
                                    <th>Live Preview</th>
                                </tr>
                            </thead>
                            <tbody id="pseoBrandsTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB 3: TRANSLATIONS -->
            <section id="tab-translations" style="display:none;">
                <div class="admin-panel-card">
                    <div class="admin-card-title">
                        <span>Language & Dictionary Manager</span>
                        <button class="btn-theme-action" onclick="saveTranslations()"><i class="bi bi-floppy-fill"></i> Save All Translations</button>
                    </div>
                    <div class="admin-card-subtitle">Edit text strings across English, Spanish, French, and Portuguese in real-time.</div>

                    <ul class="nav nav-pills mb-3" id="langTabs">
                        <li class="nav-item"><button class="nav-link active" onclick="switchLangTab('en', this)">🇺🇸 English (EN)</button></li>
                        <li class="nav-item"><button class="nav-link" onclick="switchLangTab('es', this)">🇪🇸 Spanish (ES)</button></li>
                        <li class="nav-item"><button class="nav-link" onclick="switchLangTab('fr', this)">🇫🇷 French (FR)</button></li>
                        <li class="nav-item"><button class="nav-link" onclick="switchLangTab('pt', this)">🇵🇹 Portuguese (PT)</button></li>
                    </ul>

                    <div class="mb-3">
                        <input type="text" id="transSearchInput" class="form-control" placeholder="Search translation keys..." oninput="filterTranslations()">
                    </div>

                    <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                        <table class="table table-bordered align-middle" style="font-size: 0.84rem;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 35%;">Key Identifier</th>
                                    <th>Translated Text</th>
                                </tr>
                            </thead>
                            <tbody id="translationsTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB 4: SITEMAPS -->
            <section id="tab-sitemaps" style="display:none;">
                <div class="admin-panel-card">
                    <div class="admin-card-title">
                        <span>Sitemap Index & Sub-Sitemaps</span>
                        <button class="btn-theme-outline" onclick="loadSitemaps()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                    </div>
                    <div class="admin-card-subtitle">Each sub-sitemap splits URLs into 500-page chunks for rapid crawler indexing.</div>

                    <div class="mb-3 p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold">Master Sitemap Index</div>
                            <span class="text-muted" id="masterSitemapUrl">https://findercoupon.vercel.app/sitemap.xml</span>
                        </div>
                        <a href="/sitemap.xml" target="_blank" class="btn-theme-action"><i class="bi bi-box-arrow-up-right"></i> Open Index</a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" style="font-size: 0.85rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>File Name</th>
                                    <th>Sub-Sitemap URL</th>
                                    <th>Chunk Number</th>
                                    <th>Estimated URLs</th>
                                    <th>Direct Action</th>
                                </tr>
                            </thead>
                            <tbody id="sitemapsTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB 5: MEDIA DOWNLOADER -->
            <section id="tab-downloader" style="display:none;">
                <div class="admin-panel-card">
                    <div class="admin-card-title">
                        <span>Media Downloader (Video & Audio)</span>
                        <span class="admin-badge"><i class="bi bi-play-circle-fill"></i> READY</span>
                    </div>
                    <div class="admin-card-subtitle">Manage and test high-speed audio and video media exports for coupon deals.</div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-4 border rounded-3 bg-light">
                                <h5 class="fw-bold mb-2"><i class="bi bi-file-earmark-music-fill text-primary"></i> Audio Downloader</h5>
                                <p class="text-muted" style="font-size: 0.84rem;">Serves high-quality audio coupons/podcasts with proper <code>audio/mpeg</code> MIME streaming.</p>
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size:0.8rem;">Test Audio URL or ID</label>
                                    <input type="text" id="testAudioUrl" class="form-control" value="coupon_audio_deal_101.mp3">
                                </div>
                                <button class="btn-theme-action" onclick="testDownload('audio')"><i class="bi bi-cloud-arrow-down-fill"></i> Trigger Audio Download</button>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-4 border rounded-3 bg-light">
                                <h5 class="fw-bold mb-2"><i class="bi bi-film text-danger"></i> Video Downloader</h5>
                                <p class="text-muted" style="font-size: 0.84rem;">Serves video instructions & reviews with optimized <code>video/mp4</code> headers.</p>
                                <div class="mb-3">
                                    <label class="form-label fw-bold" style="font-size:0.8rem;">Test Video URL or ID</label>
                                    <input type="text" id="testVideoUrl" class="form-control" value="coupon_video_guide_2026.mp4">
                                </div>
                                <button class="btn-theme-action" onclick="testDownload('video')"><i class="bi bi-cloud-arrow-down-fill"></i> Trigger Video Download</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TAB 6: CPA LOCKER -->
            <section id="tab-locker" style="display:none;">
                <div class="admin-panel-card">
                    <div class="admin-card-title">
                        <span>OGAds CPA Content Locker Status</span>
                        <button class="btn-theme-outline" onclick="testDevUnlock()"><i class="bi bi-unlock-fill"></i> Test Verification Ping</button>
                    </div>
                    <div class="admin-card-subtitle">Ensures strict 1-offer mandatory unlock and postback routing parameters.</div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 0.82rem;">Global Postback URL (Set in OGAds Dashboard)</label>
                            <div class="input-group">
                                <input type="text" id="postbackUrlBox" class="form-control" readonly value="https://findercoupon.vercel.app/api/postback?ip={ip}&offerid={offer_id}&payout={payout}&site={aff_sub4}">
                                <button class="btn btn-outline-secondary" onclick="copyPostback()"><i class="bi bi-clipboard"></i> Copy</button>
                            </div>
                            <small class="text-muted">Directs OGAds conversions to record completions for visitor IP & session.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="font-size: 0.82rem;">Anti-Bypass Guard</label>
                            <div class="p-2 border rounded-2 bg-light">
                                <span class="badge bg-success me-1">ACTIVE</span>
                                <small>Offers: 2 displayed &bull; Required Completions: EXACTLY 1 &bull; 10-Hour Bypass: Enabled</small>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- Client-Side Dashboard Script -->
    <script>
        let currentAuthToken = localStorage.getItem('cf_admin_jwt') || '';
        let pseoData = { brands: [], intentModifiers: [], settings: {} };
        let translationsData = {};
        let activeLangTab = 'en';

        document.addEventListener('DOMContentLoaded', () => {
            if (currentAuthToken) {
                verifyTokenAndLoad();
            } else {
                showLoginModal();
            }
        });

        function showToast(msg) {
            const toast = document.getElementById('toastNotice');
            document.getElementById('toastMsg').textContent = msg;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 3000);
        }

        async function verifyTokenAndLoad() {
            try {
                const res = await fetch('/api/admin?action=verify', {
                    headers: { 'Authorization': `Bearer ${currentAuthToken}` }
                });
                if (res.ok) {
                    document.getElementById('loginOverlay').style.display = 'none';
                    loadDashboardStats();
                    loadPseoData();
                    loadTranslationsData();
                    loadSitemaps();
                } else {
                    showLoginModal();
                }
            } catch (e) {
                showLoginModal();
            }
        }

        function showLoginModal() {
            document.getElementById('loginOverlay').style.display = 'flex';
        }

        async function handleLogin(e) {
            e.preventDefault();
            const btn = document.getElementById('loginSubmitBtn');
            const err = document.getElementById('loginErrorMsg');
            err.style.display = 'none';
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Verifying...';

            const username = document.getElementById('adminUserInput').value.trim();
            const password = document.getElementById('adminPassInput').value.trim();

            try {
                const res = await fetch('/api/admin?action=login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });

                const data = await res.json();
                if (res.ok && data.token) {
                    currentAuthToken = data.token;
                    localStorage.setItem('cf_admin_jwt', data.token);
                    document.getElementById('currentAdminName').textContent = data.user || 'admin';
                    document.getElementById('loginOverlay').style.display = 'none';
                    showToast('Successfully logged in.');
                    loadDashboardStats();
                    loadPseoData();
                    loadTranslationsData();
                    loadSitemaps();
                } else {
                    err.textContent = data.error || 'Authentication failed.';
                    err.style.display = 'block';
                }
            } catch (err) {
                err.textContent = 'Server connection error.';
                err.style.display = 'block';
            } finally {
                btn.innerHTML = '<i class="bi bi-shield-lock-fill"></i> Authenticate & Enter';
            }
        }

        function handleLogout() {
            localStorage.removeItem('cf_admin_jwt');
            currentAuthToken = '';
            showLoginModal();
        }

        function switchTab(tabId, el) {
            document.querySelectorAll('.admin-sidebar .admin-nav-item').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            document.querySelectorAll('main > section').forEach(sec => sec.style.display = 'none');
            const target = document.getElementById(`tab-${tabId}`);
            if (target) target.style.display = 'block';
        }

        async function loadDashboardStats() {
            try {
                const res = await fetch('/api/admin?action=stats', {
                    headers: { 'Authorization': `Bearer ${currentAuthToken}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    const s = data.stats;
                    document.getElementById('metricTotalPages').textContent = s.totalPseoPages.toLocaleString();
                    document.getElementById('metricTotalBrands').textContent = s.totalBrands;
                    document.getElementById('metricTotalLanguages').textContent = s.totalLanguages;
                    document.getElementById('metricTotalSitemaps').textContent = s.totalSitemaps;
                }
            } catch (e) {}
        }

        async function loadPseoData() {
            try {
                const res = await fetch('/api/admin?action=get_pseo', {
                    headers: { 'Authorization': `Bearer ${currentAuthToken}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    pseoData = data.config;
                    renderBrandsTable();
                }
            } catch (e) {}
        }

        function renderBrandsTable() {
            const tbody = document.getElementById('pseoBrandsTableBody');
            tbody.innerHTML = '';
            (pseoData.brands || []).forEach(b => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${b.name}</strong></td>
                    <td><code>${b.slug}</code></td>
                    <td><span class="badge bg-secondary">${b.category || 'general'}</span></td>
                    <td><span class="badge bg-success">${b.bestDiscount}</span></td>
                    <td>${b.avgSavings}</td>
                    <td>
                        <a href="/coupons/${b.slug}-promo-codes" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-box-arrow-up-right"></i> Test Page
                        </a>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        async function addNewBrand() {
            const name = document.getElementById('newBrandName').value.trim();
            const slug = document.getElementById('newBrandSlug').value.trim().toLowerCase();
            const bestDiscount = document.getElementById('newBrandDiscount').value.trim() || '20% OFF';

            if (!name || !slug) {
                alert('Please enter brand name and slug.');
                return;
            }

            const newBrand = {
                slug,
                name,
                category: "shopping",
                bestDiscount,
                logo: `https://logo.clearbit.com/${slug}.com`,
                domain: `${slug}.com`,
                avgSavings: "$20"
            };

            pseoData.brands.push(newBrand);
            renderBrandsTable();

            await fetch('/api/admin?action=save_pseo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${currentAuthToken}`
                },
                body: JSON.stringify({ config: pseoData })
            });

            showToast(`Brand ${name} added.`);
            loadDashboardStats();
            loadSitemaps();
        }

        async function runBulkGenerate() {
            const res = await fetch('/api/admin?action=bulk_generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${currentAuthToken}`
                },
                body: JSON.stringify({ brands: [], intents: [] })
            });
            if (res.ok) {
                const data = await res.json();
                showToast(data.message);
                loadDashboardStats();
                loadSitemaps();
            }
        }

        async function loadTranslationsData() {
            try {
                const res = await fetch('/api/admin?action=get_translations', {
                    headers: { 'Authorization': `Bearer ${currentAuthToken}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    translationsData = data.translations;
                    renderTranslationsTable();
                }
            } catch (e) {}
        }

        function switchLangTab(lang, el) {
            document.querySelectorAll('#langTabs .nav-link').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            activeLangTab = lang;
            renderTranslationsTable();
        }

        function renderTranslationsTable(filter = '') {
            const tbody = document.getElementById('translationsTableBody');
            tbody.innerHTML = '';
            const dict = translationsData[activeLangTab] || {};

            Object.entries(dict).forEach(([key, val]) => {
                if (filter && !key.toLowerCase().includes(filter.toLowerCase()) && !val.toLowerCase().includes(filter.toLowerCase())) {
                    return;
                }
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><code>${key}</code></td>
                    <td>
                        <input type="text" class="form-control form-control-sm" value="${val.replace(/"/g, '&quot;')}" onchange="updateTranslationKey('${key}', this.value)">
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterTranslations() {
            const query = document.getElementById('transSearchInput').value;
            renderTranslationsTable(query);
        }

        function updateTranslationKey(key, newVal) {
            if (!translationsData[activeLangTab]) translationsData[activeLangTab] = {};
            translationsData[activeLangTab][key] = newVal;
        }

        async function saveTranslations() {
            const res = await fetch('/api/admin?action=save_translations', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${currentAuthToken}`
                },
                body: JSON.stringify({ translations: translationsData })
            });
            if (res.ok) {
                showToast('Translations saved successfully.');
            }
        }

        async function loadSitemaps() {
            try {
                const res = await fetch('/api/admin?action=sitemaps_list', {
                    headers: { 'Authorization': `Bearer ${currentAuthToken}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    document.getElementById('masterSitemapUrl').textContent = data.masterIndex;
                    const tbody = document.getElementById('sitemapsTableBody');
                    tbody.innerHTML = '';
                    (data.sitemaps || []).forEach(sm => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td><strong>${sm.name}</strong></td>
                            <td><code>${sm.url}</code></td>
                            <td>Chunk #${sm.chunk}</td>
                            <td><span class="badge bg-primary">${sm.estimatedUrls} URLs</span></td>
                            <td>
                                <a href="${sm.url}" target="_blank" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-box-arrow-up-right"></i> View
                                </a>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                }
            } catch (e) {}
        }

        function testDownload(type) {
            const url = `/api/download?type=${type}&id=test_deal_2026`;
            window.open(url, '_blank');
            showToast(`Triggered ${type} media download test.`);
        }

        async function testDevUnlock() {
            try {
                const res = await fetch('/api/check?admin_unlock=couponfinder_dev_test');
                if (res.ok) {
                    showToast('CPA Locker verification test acknowledged successfully.');
                }
            } catch (e) {}
        }

        function copyPostback() {
            const box = document.getElementById('postbackUrlBox');
            navigator.clipboard.writeText(box.value);
            showToast('Postback URL copied to clipboard.');
        }

        function toggleTheme() {
            const doc = document.documentElement;
            const isDark = doc.getAttribute('data-theme') === 'dark';
            doc.setAttribute('data-theme', isDark ? 'light' : 'dark');
            document.getElementById('themeIcon').className = isDark ? 'bi bi-moon-stars' : 'bi bi-sun';
        }
    </script>
</body>
</html>