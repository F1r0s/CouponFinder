<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CouponFinder - Save Big Today</title>
    <meta name="description" content="Find exclusive coupon codes.">
    <meta name="keywords"
        content="coupons, promo codes, discounts, Shein, Nike, McDonald's, Burger King, Tesla, Amazon, Adidas, Starbucks, H&M, Zara, Uber">
    <meta name="author" content="CouponFinder">
    <meta name="robots" content="index, follow">
    <meta property="og:title" content="CouponFinder - Save Big Today">
    <meta property="og:description" content="Find exclusive coupon codes.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://findercoupon.vercel.app/">
    <meta property="og:image" content="logo.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="CouponFinder - Save Big Today">
    <meta name="twitter:description" content="Find exclusive coupon codes.">
    <link rel="canonical" href="https://findercoupon.vercel.app/">
    <link rel="icon" type="image/png" href="logo.png">

    <!-- Fonts & Preconnect Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://logo.clearbit.com">
    <link rel="dns-prefetch" href="https://images.unsplash.com">
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css">
</head>

<body class="theme-light">

    <!-- Header -->
    <header class="site-header">
        <nav class="site-nav">
            <a href="/" class="nav-brand">
                <img src="logo.png" alt="CouponFinder" class="nav-logo">
            </a>
            <div class="nav-search">
                <span class="search-placeholder-icon">👉</span>
                <input type="search" id="searchInput" placeholder="Search here" autocomplete="off">
            </div>
            <!-- Language Selector -->
            <div class="lang-selector" id="langSelector">
                <button class="lang-btn" id="langBtn" aria-label="Choose language" type="button">
                    <i class="bi bi-globe2"></i>
                    <span class="lang-code" id="langCurrentCode">EN</span>
                    <i class="bi bi-chevron-down lang-chevron"></i>
                </button>
                <div class="lang-menu" id="langMenu">
                    <button type="button" class="lang-item active" data-lang="en">
                        <span class="lang-flag">🇺🇸</span> English
                    </button>
                    <button type="button" class="lang-item" data-lang="es">
                        <span class="lang-flag">🇪🇸</span> Español
                    </button>
                    <button type="button" class="lang-item" data-lang="fr">
                        <span class="lang-flag">🇫🇷</span> Français
                    </button>
                    <button type="button" class="lang-item" data-lang="pt">
                        <span class="lang-flag">🇵🇹</span> Português
                    </button>
                </div>
            </div>

            <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                <i class="bi bi-moon-fill"></i>
            </button>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Section Title -->
        <h1 class="section-title" id="sectionTitle" data-i18n="all_coupons">All Coupons</h1>

        <!-- Filter Bar -->
        <div class="filter-bar" id="filterBar">
            <button class="filter-chip active" data-filter="all" data-i18n="filter_all">All</button>
            <button class="filter-chip" data-filter="fashion" data-i18n="filter_fashion">🛍️ Fashion</button>
            <button class="filter-chip" data-filter="food" data-i18n="filter_food">🍔 Food</button>
            <button class="filter-chip" data-filter="tech" data-i18n="filter_tech">💻 Tech</button>
            <button class="filter-chip" data-filter="shopping" data-i18n="filter_shopping">🛒 Shopping</button>
            <button class="filter-chip" data-filter="travel" data-i18n="filter_travel">✈️ Travel</button>
        </div>

        <!-- Coupons Grid -->
        <div class="coupons-grid" id="couponsGrid">
            <!-- Injected by JS -->
        </div>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <img src="logo.png" alt="CouponFinder" class="footer-logo">
                <p data-i18n="footer_brand_desc">Your #1 source for verified coupon codes from the world's top brands.
                </p>
            </div>
            <div class="footer-col">
                <h4 data-i18n="quick_links">Quick Links</h4>
                <a href="#" data-i18n="link_home">Home</a>
                <a href="privacy.html" data-i18n="link_privacy">Privacy Policy</a>
                <a href="terms.html" data-i18n="link_terms">Terms of Service</a>
                <a href="sitemap.xml" data-i18n="link_sitemap">Sitemap</a>
            </div>
            <div class="footer-col">
                <h4 data-i18n="top_brands">Top Brands</h4>
                <a href="#">Shein</a>
                <a href="#">Nike</a>
                <a href="#">McDonald's</a>
                <a href="#">Amazon</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 CouponFinder. <span data-i18n="all_rights_reserved">All rights reserved.</span></p>
        </div>
    </footer>

    <!-- =============================================
         COUPON MODAL (Multi-Stage Claim Flow)
         ============================================= -->
    <div class="modal-overlay" id="couponModal">
        <div class="modal-container">
            <!-- Modal Header (persistent across steps) -->
            <div class="modal-header-section" id="modalHeader">
                <div class="modal-brand-info">
                    <img src="" alt="" class="modal-brand-logo" id="modalBrandLogo" onerror="this.style.display='none'">
                    <div class="modal-brand-text">
                        <span class="modal-brand-name" id="modalBrandName"></span>
                        <h3 class="modal-coupon-title" id="modalCouponTitle"></h3>
                        <div class="modal-badges">
                            <span class="modal-badge coupons-badge">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path
                                        d="M14 4H10C6.2 4 4.3 4 3.1 5.2C2.3 6 2.1 7.1 2 9c0 .4 0 .5.1.7.1.1.3.3.9.6.6.3 1 1 1 1.7s-.4 1.4-1 1.7c-.6.3-.8.5-.9.6-.1.1-.1.3-.1.7.1 1.9.3 3 1.1 3.8C4.3 20 6.2 20 10 20h4c3.8 0 5.7 0 6.9-1.2.8-.8 1-1.9 1.1-3.8 0-.4 0-.5-.1-.7-.1-.1-.3-.3-.9-.6-.6-.3-1-1-1-1.7s.4-1.4 1-1.7c.6-.3.8-.5.9-.6.1-.1.1-.3.1-.7-.1-1.9-.3-3-1.1-3.8C19.7 4 17.8 4 14 4Z"
                                        stroke="currentColor" stroke-width="1.5" />
                                </svg>
                                <span id="modalCouponsLeft">0 coupons left</span>
                            </span>
                            <span class="modal-badge verified-badge">
                                <i class="bi bi-patch-check-fill"></i> Verified
                            </span>
                        </div>
                    </div>
                </div>
                <button class="modal-close" id="modalClose">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Progress Stepper (visible on Step 2 & 3) -->
            <div class="locker-stepper hidden" id="lockerStepper">
                <div class="stepper-step active" id="stepperStep1">
                    <div class="step-num"><i class="bi bi-shield-lock-fill"></i></div>
                    <div class="step-info">
                        <span class="step-title">Step 1</span>
                        <span class="step-desc">Verify</span>
                    </div>
                </div>
                <div class="stepper-line" id="stepperLine"></div>
                <div class="stepper-step" id="stepperStep2">
                    <div class="step-num"><i class="bi bi-key-fill"></i></div>
                    <div class="step-info">
                        <span class="step-title">Step 2</span>
                        <span class="step-desc">Unlocked</span>
                    </div>
                </div>
            </div>

            <!-- STEP 1: Coupon Overview -->
            <div class="modal-body" id="modalStep1">
                <!-- Incentive Box -->
                <div class="modal-incentive" id="modalIncentive">
                    <span class="incentive-main" id="modalIncentiveText"></span>
                    <span class="incentive-sub" id="modalIncentiveDesc"></span>
                </div>

                <!-- Stats -->
                <div class="modal-stats">
                    <div class="stat-item">
                        <div class="stat-value">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M17.286 21.09q-1.69.001-5.288-2.615-3.596 2.617-5.288 2.616-2.726 0-.495-6.8Q-3.174 7.516 8.35 7.516h.076Q10.211 2 11.998 2q1.785 0 3.574 5.516h.076q11.525 0 2.133 6.774 2.23 6.802-.497 6.8"
                                    fill="var(--accent)" />
                            </svg>
                            <span id="modalRating">5.0</span>
                        </div>
                        <div class="stat-label"><span id="modalRatingsCount">7581</span> Ratings</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <circle cx="9" cy="6" r="4" stroke="var(--accent)" stroke-width="1.5" />
                                <path d="M15 9c1.657 0 3-1.343 3-3s-1.343-3-3-3" stroke="var(--accent)"
                                    stroke-width="1.5" stroke-linecap="round" />
                                <ellipse cx="9" cy="17" rx="7" ry="4" stroke="var(--accent)" stroke-width="1.5" />
                                <path d="M18 14c1.754.385 3 1.359 3 2.5 0 1.029-1.014 1.923-2.5 2.37"
                                    stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            <span id="modalUsesToday">42</span>
                        </div>
                        <div class="stat-label">Used today</div>
                    </div>
                </div>

                <!-- Details -->
                <div class="modal-details">
                    <h4 data-i18n="details_title">Details</h4>
                    <p id="modalDescription"></p>
                </div>

                <!-- Code Reveal Bar -->
                <div class="modal-code-bar">
                    <div class="code-masked" id="modalMaskedCode">•••••••t345</div>
                    <button class="btn-show-code" id="btnShowCode" data-i18n="show_coupon_code">Show Coupon
                        Code</button>
                </div>
            </div>

            <!-- STEP 2: Locked Code + CUSTOM THEMED API LOCKER -->
            <div class="modal-body hidden" id="modalStep2">
                <div class="step2-content">
                    <h3 class="step2-title">Your Coupon Code is Ready!</h3>
                    <p class="step2-subtitle">The code will be revealed below immediately after verification</p>

                    <!-- Locked Code Box with corner frames -->
                    <div class="locked-code-box">
                        <div class="corner-frame tl"></div>
                        <div class="corner-frame tr"></div>
                        <div class="corner-frame bl"></div>
                        <div class="corner-frame br"></div>
                        <div class="locked-code-header">
                            <span class="locked-label">COUPON CODE</span>
                            <span class="locked-status" id="lockedStatus">
                                <i class="bi bi-lock-fill"></i> LOCKED
                            </span>
                        </div>
                        <div class="locked-code-value" id="lockedCodeValue">
                            •••••••4829
                        </div>
                    </div>

                    <!-- Custom Themed Content Locker Section -->
                    <div class="api-locker-box">
                        <div class="locker-notice">
                            <div class="locker-notice-icon">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div class="locker-notice-body">
                                <h4>Complete 1 Offer to Unlock</h4>
                                <p>Choose <strong>either Offer 1 or Offer 2</strong> below. You only need to finish
                                    <strong>1 offer</strong> to unlock your full coupon code!
                                </p>
                            </div>
                        </div>

                        <!-- Dynamic Offer Cards -->
                        <div class="api-locker-offers" id="apiLockerOffers">
                            <!-- Populated dynamically from /api/offers -->
                        </div>

                        <!-- Live Polling & Verification Status Bar -->
                        <div class="api-locker-status hidden" id="apiLockerStatus">
                            <div class="status-pulse-wrapper">
                                <span class="pulse-indicator"></span>
                                <span class="status-msg" id="apiLockerStatusMsg">Checking verification with
                                    server...</span>
                            </div>
                            <button class="btn-check-manual" id="btnCheckManual" onclick="checkStatusManual()">
                                <i class="bi bi-arrow-clockwise"></i> Check Now
                            </button>
                        </div>

                        <div class="locker-guarantee">
                            <i class="bi bi-shield-check"></i>
                            <span>Instant automatic unlock • 100% Free & Safe</span>
                        </div>
                    </div>

                    <!-- Rate this coupon -->
                    <div class="rate-coupon">
                        <span>Rate this coupon</span>
                        <div class="rate-buttons">
                            <button class="rate-btn" onclick="rateCoupon('up')"><i
                                    class="bi bi-hand-thumbs-up"></i></button>
                            <button class="rate-btn" onclick="rateCoupon('down')"><i
                                    class="bi bi-hand-thumbs-down"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 3: Code Revealed (after verification completion) -->
            <div class="modal-body hidden" id="modalStep3">
                <div class="step3-content">
                    <div class="success-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h3 class="step3-title">Code Unlocked Successfully!</h3>
                    <p class="step3-subtitle">Copy your code below and use it during checkout</p>
                    <div class="revealed-code-box">
                        <span class="revealed-code" id="revealedCode"></span>
                        <button class="copy-btn" id="copyBtn" onclick="copyCode()">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>
                    <div class="code-unlocked-meta">
                        <div class="meta-item">
                            <i class="bi bi-clock-history"></i>
                            <span>Valid for 24 hours</span>
                        </div>
                        <div class="meta-item">
                            <i class="bi bi-patch-check"></i>
                            <span>Verified working today</span>
                        </div>
                    </div>
                    <div class="media-download-bar">
                        <a href="/api/download?type=audio" class="btn-media-dl" id="dlAudioBtn" target="_blank" download>
                            <i class="bi bi-file-earmark-music-fill"></i> Download Audio
                        </a>
                        <a href="/api/download?type=video" class="btn-media-dl" id="dlVideoBtn" target="_blank" download>
                            <i class="bi bi-film"></i> Download Video
                        </a>
                    </div>
                    <button class="btn-done" onclick="closeModal()">
                        <i class="bi bi-check2"></i> Done
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>

</html>
