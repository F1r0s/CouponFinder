{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "data/**/*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/sitemap.xml", "dest": "/api/sitemap.js?index=1" },
    { "src": "/sitemap_([0-9]+)\\.xml", "dest": "/api/sitemap.js?page=$1" },
    { "src": "/(en|es|fr|pt)/coupons/(.*)", "dest": "/api/pseo.js?lang=$1&slug=$2" },
    { "src": "/coupons/(.*)", "dest": "/api/pseo.js?slug=$1" },
    { "src": "/secretadmin2026here", "dest": "/secretadmin2026here.html" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin.js?action=$1" },
    { "src": "/api/admin", "dest": "/api/admin.js" },
    { "src": "/api/offers", "dest": "/api/offers.js" },
    { "src": "/api/check", "dest": "/api/check.js" },
    { "src": "/api/postback", "dest": "/api/postback.js" },
    { "src": "/api/download", "dest": "/api/download.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
