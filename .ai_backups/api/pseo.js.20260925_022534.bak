// ============================================
// Programmatic SEO (pSEO) Dynamic Page Renderer
// Generates SEO landing pages with Schema.org & connects directly
// to the verified 1-offer OGAds CPA locker
// ============================================

import pseoConfig from '../data/pseo-config.json' assert { type: 'json' };
import translations from '../data/translations.json' assert { type: 'json' };

export default async function handler(req, res) {
    const siteUrl = process.env.NEXT_PUBLIC_SITE_URL || 'https://findercoupon.vercel.app/';
    const lang = (req.query?.lang || 'en').toLowerCase();
    const slug = req.query?.slug || 'shein-promo-codes';

    // Parse brand and intent from slug (e.g. "nike-promo-codes" -> brand: nike, intent: promo-codes)
    let matchedBrand = null;
    let matchedIntent = null;

    for (const b of pseoConfig.brands) {
        if (slug.startsWith(b.slug)) {
            matchedBrand = b;
            const remaining = slug.replace(`${b.slug}-`, '');
            matchedIntent = pseoConfig.intentModifiers.find(i => i.slug === remaining)
                || pseoConfig.intentModifiers[0];
            break;
        }
    }

    // Default fallback if unmatched
    if (!matchedBrand) {
        matchedBrand = pseoConfig.brands[0];
        matchedIntent = pseoConfig.intentModifiers[0];
    }

    const tpl = pseoConfig.templates[lang] || pseoConfig.templates['en'];
    const brandName = matchedBrand.name;
    const intentLabel = matchedIntent[lang] || matchedIntent['en'];
    const bestDiscount = matchedBrand.bestDiscount;
    const avgSavings = matchedBrand.avgSavings;
    const domain = matchedBrand.domain;

    const pageTitle = tpl.title
        .replace('{brand}', brandName)
        .replace('{intent}', intentLabel)
        .replace('{bestDiscount}', bestDiscount);

    const metaDesc = tpl.metaDesc
        .replace('{brand}', brandName)
        .replace('{intent}', intentLabel)
        .replace('{bestDiscount}', bestDiscount);

    const heroHeading = tpl.heroHeading
        .replace('{brand}', brandName)
        .replace('{intent}', intentLabel);

    const heroSub = tpl.heroSub
        .replace('{brand}', brandName)
        .replace('{avgSavings}', avgSavings);

    const faq1_q = tpl.faq1_q.replace('{brand}', brandName);
    const faq1_a = tpl.faq1_a.replace('{brand}', brandName).replace('{domain}', domain);
    const faq2_q = tpl.faq2_q.replace('{brand}', brandName);
    const faq2_a = tpl.faq2_a.replace('{brand}', brandName);

    const canonicalUrl = lang === 'en'
        ? `${siteUrl}/coupons/${slug}`
        : `${siteUrl}/${lang}/coupons/${slug}`;

    const dateToday = new Date().toISOString().split('T')[0];

    // Schema.org JSON-LD
    const jsonLd = {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Store",
                "name": brandName,
                "url": `https://${domain}`,
                "logo": matchedBrand.logo
            },
            {
                "@type": "SaleEvent",
                "name": `${brandName} ${intentLabel}`,
                "startDate": dateToday,
                "endDate": "2026-12-31",
                "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
                "offers": {
                    "@type": "AggregateOffer",
                    "priceCurrency": "USD",
                    "lowPrice": "0",
                    "highPrice": "500",
                    "offerCount": "15"
                }
            },
            {
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": faq1_q,
                        "acceptedAnswer": { "@type": "Answer", "text": faq1_a }
                    },
                    {
                        "@type": "Question",
                        "name": faq2_q,
                        "acceptedAnswer": { "@type": "Answer", "text": faq2_a }
                    }
                ]
            }
        ]
    };

    // Render HTML page
    const html = `<!DOCTYPE html>
<html lang="${lang}" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>${pageTitle}</title>
    <meta name="description" content="${metaDesc}">
    <link rel="canonical" href="${canonicalUrl}">
    <link rel="alternate" hreflang="en" href="${siteUrl}/coupons/${slug}">
    <link rel="alternate" hreflang="es" href="${siteUrl}/es/coupons/${slug}">
    <link rel="alternate" hreflang="fr" href="${siteUrl}/fr/coupons/${slug}">
    <link rel="alternate" hreflang="pt" href="${siteUrl}/pt/coupons/${slug}">
    <link rel="alternate" hreflang="x-default" href="${siteUrl}/coupons/${slug}">
    <link rel="icon" type="image/png" href="/logo.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">

    <!-- Schema.org -->
    <script type="application/ld+json">${JSON.stringify(jsonLd)}</script>

    <style>
        .pseo-hero {