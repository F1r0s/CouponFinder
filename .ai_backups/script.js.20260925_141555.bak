// ============================================
// STATE & TRANSLATIONS
// ============================================
let currentFilter = 'all';
let activeCoupon = null;
let pollInterval = null;
let currentLanguage = localStorage.getItem('site_lang') || 'en';
let translationsData = {};

async function loadTranslations() {
    try {
        const res = await fetch('/data/translations.json');
        if (res.ok) {
            translationsData = await res.json();
            applyLanguage(currentLanguage);
        } else {
            console.warn('Could not load data/translations.json');
        }
    } catch (err) {
        console.error('Failed to load translations:', err);
    }
}

function applyLanguage(lang) {
    currentLanguage = lang;
    localStorage.setItem('site_lang', lang);

    document.querySelectorAll('.lang-item').forEach(item => {
        if (item.dataset.lang === lang) {
            item.classList.add('active');
        } else {
            item.classList.remove('active');
        }
    });

    const currentCodeEl = document.getElementById('langCurrentCode');
    if (currentCodeEl) {
        currentCodeEl.textContent = lang.toUpperCase();
    }

    if (!translationsData || !translationsData[lang]) return;
    const dict = translationsData[lang] || translationsData['en'] || {};

    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) {
            if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                el.placeholder = dict[key];
            } else {
                el.textContent = dict[key];
            }
        }
    });

    const searchInput = document.getElementById('searchInput');
    if (searchInput && dict['search_placeholder']) {
        searchInput.placeholder = dict['search_placeholder'];
    }

    renderCoupons(currentFilter);
}

// ============================================
// RENDER CARDS
// ============================================
function renderCoupons(filter = 'all') {
    const grid = document.getElementById('couponsGrid');
    const filtered = filter === 'all'
        ? couponsData
        : couponsData.filter(c => c.category === filter);

    grid.innerHTML = '';

    filtered.forEach((coupon, index) => {
        const card = buildCard(coupon, index);
        grid.appendChild(card);
    });
}

function buildCard(coupon, index) {
    const div = document.createElement('div');
    div.className = 'coupon-card';
    div.style.animationDelay = `${index * 0.05}s`;
    div.setAttribute('data-category', coupon.category);

    const maskedCode = formatPartialCode(coupon.code);
    const dict = (translationsData && translationsData[currentLanguage]) || {};
    const textCouponsLeft = dict['coupons_left'] || 'coupons left';
    const textGetCode = dict['get_code'] || 'Get Code';
    const textUsesToday = dict['uses_today'] || 'uses today';

    div.innerHTML = `
        <div class="card-banner">
            <img src="${coupon.bannerImg}" alt="${coupon.title}" loading="lazy">
            <div class="card-rating">
                <svg class="star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="12" height="12">
                    <path d="M17.286 21.09q-1.69.001-5.288-2.615-3.596 2.617-5.288 2.616-2.726 0-.495-6.8Q-3.174 7.516 8.35 7.516h.076Q10.211 2 11.998 2q1.785 0 3.574 5.516h.076q11.525 0 2.133 6.774 2.23 6.802-.497 6.8"/>
                </svg>
                <span>${coupon.rating}</span>
            </div>
            <img src="${coupon.brandLogo}" alt="${coupon.brand}" class="card-brand-logo"
                 onerror="this.style.display='none'">
        </div>
        <div class="card-body">
            <h3 class="card-title">${coupon.title}</h3>
            <div class="card-brand-name">${coupon.brand}</div>
            <div class="card-incentive">
                <span class="incentive-main-text">${coupon.incentiveText}</span>
                <span class="incentive-sub-text">${coupon.incentiveDesc}</span>
            </div>
            <div class="card-coupons-left">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 4H10C6.2 4 4.3 4 3.1 5.2C2.3 6 2.1 7.1 2 9c0 .4 0 .5.1.7.1.1.3.3.9.6.6.3 1 1 1 1.7s-.4 1.4-1 1.7c-.6.3-.8.5-.9.6-.1.1-.1.3-.1.7.1 1.9.3 3 1.1 3.8C4.3 20 6.2 20 10 20h4c3.8 0 5.7 0 6.9-1.2.8-.8 1-1.9 1.1-3.8 0-.4 0-.5-.1-.7-.1-.1-.3-.3-.9-.6-.6-.3-1-1-1-1.7s.4-1.4 1-1.7c.6-.3.8-.5.9-.6.1-.1.1-.3.1-.7-.1-1.9-.3-3-1.1-3.8C19.7 4 17.8 4 14 4Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M9 15l6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                ${coupon.couponsLeft} ${textCouponsLeft}
            </div>
            <button class="card-get-code" onclick="openCouponModal(${coupon.id})">
                <i class="bi bi-scissors"></i> ${textGetCode}
            </button>
        </div>
        <div class="card-footer">
            <div class="card-footer-item">
                <i class="bi bi-infinity"></i>
                <span>${coupon.expiry}</span>
            </div>
            <div class="card-footer-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="9" cy="6" r="4" stroke="var(--accent)" stroke-width="1.5"/>
                    <path d="M15 9c1.657 0 3-1.343 3-3s-1.343-3-3-3" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"/>
                    <ellipse cx="9" cy="17" rx="7" ry="4" stroke="var(--accent)" stroke-width="1.5"/>
                </svg>
                <span>${coupon.usesToday} ${textUsesToday}</span>
            </div>
        </div>
    `;

    return div;
}

function formatPartialCode(code) {
    if (!code) return '';
    const visible = code.slice(0, -3);
    const hidden = '•'.repeat(3);
    return visible + hidden;
}

function formatMaskedCode(code) {
    if (!code) return '';
    const visible = code.slice(-4);
    const hidden = '•'.repeat(code.length - 4);
    return hidden + visible;
}

// ============================================
// MODAL - Multi-Stage Claim Flow
// ============================================
function openCouponModal(couponId) {
    const coupon = couponsData.find(c => c.id === couponId);
    if (!coupon) return;

    // Check localStorage bypass (10 hours)
    const unlockKey = `cf_unlocked_${couponId}`;
    const unlockData = localStorage.getItem(unlockKey);
    if (unlockData) {
        const elapsed = Date.now() - parseInt(unlockData);
        if (elapsed < 10 * 60 * 60 * 1000) {
            // Already unlocked - go directly to step 3
            activeCoupon = coupon;
            showStep3Directly(coupon.code);
            return;
        } else {
            localStorage.removeItem(unlockKey);
        }
    }

    activeCoupon = coupon;

    // Populate modal
    document.getElementById('modalBrandLogo').src = coupon.brandLogo;
    document.getElementById('modalBrandLogo').alt = coupon.brand;
    document.getElementById('modalBrandName').textContent = coupon.brand;
    const modalDict = (translationsData && translationsData[currentLanguage]) || {};
    const modalCouponsLeftText = modalDict['coupons_left'] || 'coupons left';
    document.getElementById('modalCouponTitle').textContent = coupon.title;
    document.getElementById('modalCouponsLeft').textContent = `${coupon.couponsLeft} ${modalCouponsLeftText}`;
    document.getElementById('modalIncentiveText').textContent = coupon.incentiveText;
    document.getElementById('modalIncentiveDesc').textContent = coupon.incentiveDesc;
    document.getElementById('modalRating').textContent = coupon.rating;
    document.getElementById('modalRatingsCount').textContent = coupon.ratingsCount.toLocaleString();
    document.getElementById('modalUsesToday').textContent = coupon.usesToday;
    document.getElementById('modalDescription').textContent = coupon.description;
    document.getElementById('modalMaskedCode').textContent = formatMaskedCode(coupon.code);
    const audioBtn = document.getElementById('dlAudioBtn');
    const videoBtn = document.getElementById('dlVideoBtn');
    if (audioBtn) audioBtn.href = `/api/download?type=audio&brand=${encodeURIComponent(coupon.brand)}&id=${coupon.id}`;
    if (videoBtn) videoBtn.href = `/api/download?type=video&brand=${encodeURIComponent(coupon.brand)}&id=${coupon.id}`;

    // Reset to Step 1
    document.getElementById('modalStep1').classList.remove('hidden');
    document.getElementById('modalStep2').classList.add('hidden');
    document.getElementById('modalStep3').classList.add('hidden');
    document.getElementById('lockerStepper').classList.add('hidden');
    document.getElementById('modalHeader').style.display = '';

    // Show modal
    const overlay = document.getElementById('couponModal');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeModal() {
    const overlay = document.getElementById('couponModal');
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    clickedOfferId = null;
    if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
    }
}

// ============================================
// API OFFERS & LOCKER STATE
// ============================================
let cachedOffers = [];
let isCheckingStatus = false;

async function fetchOffers() {
    // 1. Try serverless backend proxy first
    try {
        const response = await fetch('/api/offers');
        if (response.ok) {
            const data = await response.json();
            if (Array.isArray(data) && data.length > 0) {
                cachedOffers = data;
                return cachedOffers;
            }
        }
    } catch (err) {
        // Backend proxy not available (e.g. running on file:/// or static local server)
    }

    // 2. Direct OGAds API fetch using provided endpoint & key (supports CORS: Access-Control-Allow-Origin: *)
    try {
        let userIP = '105.154.187.90'; // Default fallback IP
        try {
            const ipRes = await fetch('https://api.ipify.org?format=json');
            if (ipRes.ok) {
                const ipData = await ipRes.json();
                if (ipData.ip) userIP = ipData.ip;
            }
        } catch (e) {
            // Use fallback IP if ipify blocked
        }

        const userAgent = navigator.userAgent || 'Mozilla/5.0';
        const directUrl = `https://appcomplete.org/api/v2?ip=${encodeURIComponent(userIP)}&user_agent=${encodeURIComponent(userAgent)}&max=30`;

        const response = await fetch(directUrl, {
            headers: {
                'Authorization': 'Bearer 47558|DluqLUTirEcifKUEHLp0wrBpqTebJR7XbTqwtkL666b7e813',
                'Accept': 'application/json'
            }
        });

        if (response.ok) {
            const data = await response.json();
            let offers = data.offers || [];
            if (offers.length > 0) {
                // Sort: boosted first, then payout descending
                offers.sort((a, b) => {
                    if (a.boosted && !b.boosted) return -1;
                    if (!a.boosted && b.boosted) return 1;
                    return (parseFloat(b.payout) || 0) - (parseFloat(a.payout) || 0);
                });

                cachedOffers = offers.slice(0, 2).map(offer => ({
                    id: offer.offerid || offer.id,
                    name: offer.name_short || offer.name || 'Complete Offer',
                    description: offer.adcopy || offer.description || 'Quick verification',
                    image: offer.picture || offer.icon || '',
                    link: offer.link || offer.url || '#',
                    payout: parseFloat(offer.payout) || 0,
                    boosted: !!offer.boosted
                }));
                return cachedOffers;
            }
        }
    } catch (err) {
        console.log('Direct OGAds fetch failed, using fallback offers:', err.message);
    }

    // 3. Fallback offers if offline
    cachedOffers = [
        {
            id: 101,
            name: "Install & Open TikTok",
            description: "Download, install, and open the TikTok app for 30 seconds to verify.",
            image: "https://images.unsplash.com/photo-1611162617474-5b21e879e113?w=120&h=120&fit=crop",
            link: "https://tiktok.com",
            payout: 1.50
        },
        {
            id: 102,
            name: "Complete Quick 2-Min Survey",
            description: "Answer 4 brief questions to instantly verify your human session.",
            image: "https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=120&h=120&fit=crop",
            link: "https://surveys.com",
            payout: 1.25
        }
    ];
    return cachedOffers;
}

function renderLockerOffers() {
    const container = document.getElementById('apiLockerOffers');
    if (!container) return;

    if (!cachedOffers || cachedOffers.length === 0) {
        container.innerHTML = '<div style="padding:15px;text-align:center;color:var(--text-secondary);font-size:0.8rem;">Loading available offers...</div>';
        return;
    }

    container.innerHTML = '';

    cachedOffers.slice(0, 2).forEach((offer, index) => {
        const card = document.createElement('div');
        card.className = 'api-offer-card';
        card.id = `offerCard_${offer.id}`;
        card.onclick = (e) => handleOfferClick(offer, card, e);

        const badgeText = index === 0 ? '⚡ Fast Unlock' : '★ Most Popular';

        card.innerHTML = `
            <div class="offer-icon-wrapper">
                <img src="${offer.image}" alt="${offer.name}" class="offer-icon-img"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                <i class="bi bi-gift-fill offer-icon-fallback" style="display:none;"></i>
            </div>
            <div class="offer-details">
                <span class="offer-badge-pill">${badgeText}</span>
                <div class="offer-title">${offer.name}</div>
                <div class="offer-desc">${offer.description}</div>
            </div>
            <button class="btn-offer-action" id="btnOffer_${offer.id}">
                <i class="bi bi-box-arrow-up-right"></i> Verify
            </button>
        `;

        container.appendChild(card);
    });
}

// Step 1 → Step 2: "Show Coupon Code" button
document.addEventListener('DOMContentLoaded', async () => {
    // --- Theme Toggle Logic ---
    const themeToggle = document.getElementById('themeToggle');
    const rootHtml = document.documentElement;
    const body = document.body;

    const savedTheme = localStorage.getItem('theme') || 'light';
    if (savedTheme === 'dark') {
        rootHtml.setAttribute('data-theme', 'dark');
        body.classList.remove('theme-light');
        body.classList.add('theme-dark');
        themeToggle.innerHTML = '<i class="bi bi-sun-fill"></i>';
    }

    themeToggle.addEventListener('click', () => {
        if (rootHtml.getAttribute('data-theme') === 'dark') {
            rootHtml.setAttribute('data-theme', 'light');
            body.classList.remove('theme-dark');
            body.classList.add('theme-light');
            themeToggle.innerHTML = '<i class="bi bi-moon-fill"></i>';
            localStorage.setItem('theme', 'light');
        } else {
            rootHtml.setAttribute('data-theme', 'dark');
            body.classList.remove('theme-light');
            body.classList.add('theme-dark');
            themeToggle.innerHTML = '<i class="bi bi-sun-fill"></i>';
            localStorage.setItem('theme', 'dark');
        }
    });

    // --- Dynamic Coupons Loading (Groupon) ---
    try {
        const response = await fetch('/groupon.json');
        if (response.ok) {
            const extraCoupons = await response.json();
            if (Array.isArray(extraCoupons) && extraCoupons.length > 0) {
                // Determine highest ID to avoid conflicts
                let maxId = 0;
                couponsData.forEach(c => { if(c.id > maxId) maxId = c.id; });

                extraCoupons.forEach((coupon, index) => {
                    coupon.id = maxId + index + 1;
                    couponsData.push(coupon);
                });
            }
        }
    } catch (e) {
        console.log("No extra groupon coupons found or error loading them.");
    }

    await loadTranslations();
    renderCoupons();
    initSearch();
    initFilters();
    fetchOffers();

    // Language Dropdown Setup
    const langBtn = document.getElementById('langBtn');
    const langSelector = document.getElementById('langSelector');
    if (langBtn && langSelector) {
        langBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langSelector.classList.toggle('open');
        });

        document.querySelectorAll('.lang-item').forEach(item => {
            item.addEventListener('click', (e) => {
                e.stopPropagation();
                applyLanguage(item.dataset.lang);
                langSelector.classList.remove('open');
            });
        });

        document.addEventListener('click', () => {
            langSelector.classList.remove('open');
        });
    }

    document.getElementById('btnShowCode').addEventListener('click', goToStep2);
    document.getElementById('modalClose').addEventListener('click', closeModal);

    // Close on overlay click
    document.getElementById('couponModal').addEventListener('click', (e) => {
        if (e.target.id === 'couponModal') closeModal();
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
    });
});

function goToStep2() {
    if (!activeCoupon) return;

    // Transition view
    document.getElementById('modalStep1').classList.add('hidden');
    document.getElementById('modalStep2').classList.remove('hidden');
    document.getElementById('modalStep3').classList.add('hidden');

    // Stepper setup
    const stepper = document.getElementById('lockerStepper');
    stepper.classList.remove('hidden');
    document.getElementById('stepperStep1').className = 'stepper-step active';
    document.getElementById('stepperStep2').className = 'stepper-step';
    document.getElementById('stepperLine').className = 'stepper-line';

    // Show masked code in the locked box
    const lockedCodeEl = document.getElementById('lockedCodeValue');
    lockedCodeEl.textContent = formatMaskedCode(activeCoupon.code);
    lockedCodeEl.classList.remove('revealed');

    // Reset locked status
    const statusEl = document.getElementById('lockedStatus');
    statusEl.innerHTML = '<i class="bi bi-lock-fill"></i> LOCKED';
    statusEl.classList.remove('unlocked');

    // Hide status bar initially
    document.getElementById('apiLockerStatus').classList.add('hidden');

    // Render offer cards
    renderLockerOffers();
}

let clickedOfferId = null;

// Handle Offer Click - User chooses either Offer 1 or Offer 2 (Requires 1 completion)
function handleOfferClick(offer, cardEl, event) {
    if (event) event.stopPropagation();

    clickedOfferId = offer.id;

    // Open offer with sub-tracking parameters for multi-site postback routing
    let trackingLink = offer.link;
    if (trackingLink && trackingLink !== '#') {
        const userIP = window.currentUserIP || '127.0.0.1';
        const separator = trackingLink.includes('?') ? '&' : '?';
        trackingLink += `${separator}aff_sub4=couponfinder&aff_sub5=${encodeURIComponent(userIP)}`;
        window.open(trackingLink, '_blank');
    }

    // Reset all cards and highlight clicked card
    document.querySelectorAll('.api-offer-card').forEach(c => {
        c.classList.remove('active-checking');
        const b = c.querySelector('.btn-offer-action');
        if (b) {
            b.classList.remove('loading');
            b.innerHTML = '<i class="bi bi-box-arrow-up-right"></i> Verify';
        }
    });

    cardEl.classList.add('active-checking');

    // Change clicked button to spinner
    const btn = cardEl.querySelector('.btn-offer-action');
    if (btn) {
        btn.classList.add('loading');
        btn.innerHTML = '<span class="btn-spinner"></span> Awaiting Completion...';
    }

    // Show status bar
    const statusBar = document.getElementById('apiLockerStatus');
    statusBar.classList.remove('hidden');
    document.getElementById('apiLockerStatusMsg').innerHTML =
        '<strong>Activity opened in new tab.</strong> Finish the activity, then click Check Status.';

    // Start continuous polling /api/check
    startPolling();
}

// Polling Logic - Strictly unlocks ONLY when server confirms completion from OGAds
function startPolling() {
    if (pollInterval) clearInterval(pollInterval);
    isCheckingStatus = true;

    let pollAttempts = 0;
    pollInterval = setInterval(async () => {
        pollAttempts++;
        try {
            const userIP = window.currentUserIP || '';
            const checkUrl = userIP ? `/api/check?ip=${encodeURIComponent(userIP)}` : '/api/check';
            const response = await fetch(checkUrl);
            if (response.ok) {
                const data = await response.json();
                if (data.completed) {
                    clearInterval(pollInterval);
                    pollInterval = null;
                    completeUnlock();
                    return;
                }
            }
        } catch (err) {
            // Polling server
        }

        const msgEl = document.getElementById('apiLockerStatusMsg');
        if (msgEl) {
            msgEl.innerHTML = `<span class="pulse-indicator"></span> Waiting for offer completion... (Checking server)`;
        }
    }, 5000);
}

// Manual Check Button - Strictly verifies with server (DOES NOT unlock if incomplete!)
async function checkStatusManual() {
    const btn = document.getElementById('btnCheckManual');
    const msgEl = document.getElementById('apiLockerStatusMsg');

    if (!clickedOfferId) {
        if (msgEl) {
            msgEl.innerHTML = '<span style="color:#ef4444;font-weight:700;"><i class="bi bi-exclamation-circle-fill"></i> Please select and click either Offer 1 or Offer 2 above first!</span>';
        }
        return;
    }

    btn.innerHTML = '<span class="btn-spinner" style="border-top-color:var(--accent);"></span> Verifying...';
    btn.disabled = true;

    try {
        const userIP = window.currentUserIP || '';
        const checkUrl = userIP ? `/api/check?ip=${encodeURIComponent(userIP)}` : '/api/check';
        const response = await fetch(checkUrl);
        if (response.ok) {
            const data = await response.json();
            if (data.completed) {
                if (pollInterval) clearInterval(pollInterval);
                completeUnlock();
                return;
            }
        }
    } catch (e) {
        // Network check
    }

    // STRICT VERIFICATION: Offer is NOT completed yet!
    setTimeout(() => {
        btn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Check Status';
        btn.disabled = false;
        if (msgEl) {
            msgEl.innerHTML = '<span style="color:#ef4444;font-weight:700;"><i class="bi bi-x-circle-fill"></i> Not completed yet!</span> Please finish the activity in your opened tab.';
        }
    }, 1200);
}

// Called when verification is complete
function completeUnlock() {
    if (!activeCoupon) return;

    // 1. Update Stepper
    const step1 = document.getElementById('stepperStep1');
    const step2 = document.getElementById('stepperStep2');
    const line = document.getElementById('stepperLine');

    step1.className = 'stepper-step completed';
    step1.querySelector('.step-num').innerHTML = '<i class="bi bi-check2"></i>';
    line.className = 'stepper-line active';
    step2.className = 'stepper-step active';

    // 2. Update Locked Box
    const statusEl = document.getElementById('lockedStatus');
    statusEl.innerHTML = '<i class="bi bi-unlock-fill"></i> UNLOCKED';
    statusEl.classList.add('unlocked');

    const lockedCodeEl = document.getElementById('lockedCodeValue');
    lockedCodeEl.textContent = activeCoupon.code;
    lockedCodeEl.classList.add('revealed');

    // 3. Status Bar Success
    const statusBar = document.getElementById('apiLockerStatus');
    statusBar.classList.remove('hidden');
    document.getElementById('apiLockerStatusMsg').innerHTML = '<strong style="color:var(--accent);">✓ Activity verified successfully!</strong>';

    // 4. Save to localStorage (10 hours bypass)
    const unlockKey = `cf_unlocked_${activeCoupon.id}`;
    localStorage.setItem(unlockKey, Date.now().toString());

    // 5. Transition to Step 3 after brief delay
    setTimeout(() => {
        document.getElementById('modalStep2').classList.add('hidden');
        document.getElementById('modalStep3').classList.remove('hidden');
        document.getElementById('revealedCode').textContent = activeCoupon.code;
    }, 1200);
}

// Direct unlock for already-verified codes
function showStep3Directly(code) {
    document.getElementById('modalStep1').classList.add('hidden');
    document.getElementById('modalStep2').classList.add('hidden');
    document.getElementById('modalStep3').classList.remove('hidden');

    // Stepper setup
    const stepper = document.getElementById('lockerStepper');
    stepper.classList.remove('hidden');
    const step1 = document.getElementById('stepperStep1');
    const step2 = document.getElementById('stepperStep2');
    const line = document.getElementById('stepperLine');
    step1.className = 'stepper-step completed';
    step1.querySelector('.step-num').innerHTML = '<i class="bi bi-check2"></i>';
    line.className = 'stepper-line active';
    step2.className = 'stepper-step active';

    // Populate header
    document.getElementById('modalBrandLogo').src = activeCoupon.brandLogo;
    document.getElementById('modalBrandName').textContent = activeCoupon.brand;
    document.getElementById('modalCouponTitle').textContent = activeCoupon.title;
    document.getElementById('modalCouponsLeft').textContent = `${activeCoupon.couponsLeft} coupons left`;

    document.getElementById('revealedCode').textContent = code;

    const overlay = document.getElementById('couponModal');
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
}

// Global function for OGAds callback
window.revealFullCode = function() {
    if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
    }
    completeUnlock();
};

// ============================================
// COPY CODE
// ============================================
function copyCode() {
    const code = document.getElementById('revealedCode').textContent;
    const btn = document.getElementById('copyBtn');

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(code);
    } else {
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
    }

    btn.innerHTML = '<i class="bi bi-check2"></i> Copied!';
    setTimeout(() => {
        btn.innerHTML = '<i class="bi bi-clipboard"></i> Copy';
    }, 2000);
}

// ============================================
// RATE COUPON
// ============================================
function rateCoupon(direction) {
    const btns = document.querySelectorAll('.rate-btn');
    btns.forEach(b => {
        b.style.background = 'var(--bg-secondary)';
        b.style.color = 'var(--text-third)';
    });
    if (direction === 'up') {
        btns[0].style.background = 'var(--accent-light)';
        btns[0].style.color = 'var(--accent)';
    } else {
        btns[1].style.background = '#fee2e2';
        btns[1].style.color = '#ef4444';
    }
}

// ============================================
// SEARCH
// ============================================
function initSearch() {
    const input = document.getElementById('searchInput');
    input.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) {
            renderCoupons(currentFilter);
            return;
        }
        const grid = document.getElementById('couponsGrid');
        const filtered = couponsData.filter(c =>
            c.brand.toLowerCase().includes(query) ||
            c.title.toLowerCase().includes(query) ||
            c.category.toLowerCase().includes(query)
        );
        grid.innerHTML = '';
        filtered.forEach((coupon, i) => {
            const card = buildCard(coupon, i);
            grid.appendChild(card);
        });
    });
}

// ============================================
// FILTERS
// ============================================
function initFilters() {
    document.querySelectorAll('.filter-chip').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.filter;
            renderCoupons(currentFilter);
        });
    });
}
