{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "*.html",
            "use": "@vercel/static"
        },
        {
            "src": "*.css",
            "use": "@vercel/static"
        },
        {
            "src": "*.js",
            "use": "@vercel/static"
        },
        {
            "src": "*.xml",
            "use": "@vercel/static"
        },
        {
            "src": "*.txt",
            "use": "@vercel/static"
        },
        {
            "src": "*.png",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        { "src": "/api/offers", "dest": "/api/offers.js" },
        { "src": "/api/check", "dest": "/api/check.js" },
        { "src": "/api/postback", "dest": "/api/postback.js" },
        { "src": "/(.*)", "dest": "/$1" }
    ]
}
